{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "emailjs-com": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "react-scroll": "^1.8.9"
  },
  "scripts": {
    "start": "concurrently -n web,game -c blue,magenta \"vite\" \"npm --prefix game run dev\"",
    "start:web": "vite",
    "build": "vite build && npm --prefix game run build && cp -r game/dist build/game",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 114",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "jsdom": "^27.0.1",
    "tailwindcss": "^3.3.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
